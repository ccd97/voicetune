# AWS (required if DIARIZE_MODE=aws; AWS_ACCESS_KEY_ID/SECRET/SESSION_TOKEN
# fall back to the boto3 default credential chain if unset)
AWS_REGION=us-east-1                   # default: us-east-1
AWS_S3_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""

# GCP (required for GCP finetune backend)
# Auth: `gcloud auth application-default login` or set GOOGLE_APPLICATION_CREDENTIALS
GCP_PROJECT_ID=your-gcp-project-id

# HuggingFace (required for DIARIZE_MODE=whisperx|mlx)
# Accept terms: https://huggingface.co/pyannote/segmentation-3.0
#               https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=hf_your_huggingface_token_here

# llama.cpp paths (Use Gemma multimodal models)
# MODEL_PATH: required for DIARIZE_MODE=llamacpp, validation, local Gemma LLM
# MMPROJ_PATH: required for DIARIZE_MODE=llamacpp
LLAMACPP_MODEL_PATH=/path/to/your/model.gguf
LLAMACPP_MMPROJ_PATH=/path/to/your/mmproj.gguf

# Diarization backend: aws | whisperx | mlx | llamacpp
DIARIZE_MODE=mlx                       # default: whisperx

# Allowed languages (whisperx diarize + validation)
ALLOWED_LANGS=en,hi,en-US,hi-IN     # default: en

# Skip pipeline steps (true/1/yes; default: false)
SKIP_SCRUB=false
SKIP_TRANSLATE=false
SKIP_CORRECTION=false
